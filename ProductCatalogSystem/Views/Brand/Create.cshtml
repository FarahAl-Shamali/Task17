@model CreateBrandViewModel

<h1>Add Brand</h1>
<hr>

<form asp-action="Create">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="form-control">Brand Name</label>
                <input required asp-for="Name" class="form-control">
            </div>
        </div>
    </div>
    <input class="btn btn-primary" type="submit" value="Save">
    <a asp-controller="Brand" asp-action="Index" class="btn btn-danger">Back</a>
</form>