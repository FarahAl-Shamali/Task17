@model CreateProductViewModel
<h1>Create Product</h1>
<hr>
<form asp-action="Create" enctype="multipart/form-data">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="form-control">Product Name</label>
                <input required asp-for="Name" class="form-control">
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="form-control">Product Description</label>
                <input required asp-for="Description" class="form-control">
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="form-control">Product Image</label>
                <input type="file" asp-for ="ImageUrl" class="form-control">
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="form-control">Product Price</label>
                <input required asp-for="Price" class="form-control">
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="form-control">Product Category ID</label>
                <select required asp-for="CategoryId" asp-items="ViewBag.categoryList" class="form-control">
                </select>
            </div>
        </div>
    </div>
    <br />
<input class="btn btn-primary" type="submit" value="Save">
    <a asp-controller="Product" asp-action="Index" class="btn btn-danger">Back</a>
</form>