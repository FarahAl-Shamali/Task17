@model CreateUserViewModel
<h1>Add New User</h1>
<br />
<hr>
<div class="col-md-4">
    <form asp-action="Create">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label class="label-control" asp-for="Email"></label>
            <input class="form-control" asp-for="Email" />
        </div>
        <br />
        <div class="form-group">
            <label class="label-control" asp-for="Password"></label>
            <input class="form-control" asp-for="Password" />
        </div>
        <br />
        <div class="form-group">
            <label class="label-control" asp-for="PhoneNumber"></label>
            <input class="form-control" asp-for="PhoneNumber" />
        </div>
        <br />
        <div class="form-group">
            <label class="label-control" asp-for="UserType"></label>
            <select class="form-control" asp-for="UserType" asp-items="Html.GetEnumSelectList<UserType>()"></select>
        </div>
        <br />
        <input type="submit" value="Save" class="btn btn-primary" />
        <a href="~/user/index" class="btn btn-danger">Cancel</a>
    </form>
</div>