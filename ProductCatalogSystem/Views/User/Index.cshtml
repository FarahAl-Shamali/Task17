@model List<UserViewModel>

<h1>System Users</h1>
<br />
<hr />

<a asp-controller="User" asp-action="Create" class="btn btn-primary">
    Add user
</a>

@if (Model.Any())
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>User Name</th>
                <th>User Email</th>
                <th>Creation Date</th>
                <th>Role</th>
                <th>Operations</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>@user.CreatedAt</td>
                    <td>@user.UserType</td>
                    <td>
                        <a class="btn btn-danger" href="~/User/Delete/@user.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning">
        No Users To Show
    </div>
}